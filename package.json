{
  "name": "yuseons-nihongo",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-audio.mjs && tsc -b && vite build && node scripts/build-pwa.mjs && node scripts/check-audio.mjs --dist",
    "test": "vitest run",
    "test:browser": "node scripts/test-handwriting-browser.mjs",
    "test:audio": "node scripts/test-audio-browser.mjs",
    "test:ux": "node scripts/test-v130-browser.mjs",
    "test:pwa": "node scripts/test-pwa-browser.mjs",
    "strokes:generate": "node scripts/generate-strokes.mjs",
    "audio:catalog": "node scripts/audio-catalog.mjs",
    "audio:preview": "node scripts/generate-audio.mjs --preview",
    "audio:review": "node scripts/review-audio.mjs",
    "audio:pilot": "node scripts/generate-audio.mjs --pilot",
    "audio:generate": "node scripts/generate-audio.mjs",
    "audio:check": "node scripts/check-audio.mjs",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri.ps1 dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri.ps1 build",
    "desktop:info": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri.ps1 info"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "jsdom": "latest",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "vitest": "latest"
  }
}
